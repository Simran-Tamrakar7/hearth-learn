generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String?
  passwordHash   String?
  image          String?
  theme          String     @default("daylight")
  featureToggles String     @default("{\"toolkits\":true,\"showcaseWall\":true,\"gamesShelf\":true}")
  pulseCheck     String     @default("{}")
  createdAt      DateTime   @default(now())

  progress            Progress[]
  notes               Note[]
  streak              Streak?
  badges              Badge[]
  chapterFeedback     ChapterFeedback[]
  chapterMarginNotes  ChapterMarginNote[]
  showcaseItems       ShowcaseItem[]
  certificates        TrailCertificate[]
  readingProgress     ReadingProgress[]
  bookmarks           Bookmark[]
  highlights          Highlight[]
}

model Trail {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  category       String
  description    String
  difficulty     String    @default("Beginner")
  estimatedHours Int       @default(4)
  icon           String    @default("BookOpen")
  coverImage     String?
  createdAt      DateTime  @default(now())

  chapters       Chapter[]
  notes          Note[]
  showcaseItems  ShowcaseItem[]
  certificates   TrailCertificate[]
}

model Chapter {
  id               String     @id @default(uuid())
  trailId          String
  title            String
  order            Int
  content          String
  estimatedMinutes Int        @default(15)
  createdAt        DateTime   @default(now())

  trail            Trail      @relation(fields: [trailId], references: [id], onDelete: Cascade)
  progress         Progress[]
  feedback         ChapterFeedback[]
  marginNotes      ChapterMarginNote[]

  @@unique([trailId, order])
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  chapterId   String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  tags      String   @default("general")
  trailId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trail     Trail?   @relation(fields: [trailId], references: [id], onDelete: SetNull)
}

model ChapterFeedback {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model ChapterMarginNote {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ShowcaseItem {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  linkUrl     String
  trailId     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trail       Trail?   @relation(fields: [trailId], references: [id], onDelete: SetNull)
}

model TrailCertificate {
  id              String   @id @default(uuid())
  userId          String
  trailId         String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([userId, trailId])
}

model Streak {
  id           String    @id @default(uuid())
  userId       String    @unique
  currentCount Int       @default(1)
  longestCount Int       @default(1)
  lastCheckIn  DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  name        String
  title       String
  description String
  icon        String   @default("Sparkles")
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// LIBRARY MODULE ("THE STUDY") FRESH SPEC MODELS
// -------------------------------------------------------------

model Book {
  id          String   @id @default(uuid())
  title       String
  author      String
  genre       String
  description String
  coverUrl    String
  fileUrl     String
  format      String   @default("epub") // epub or pdf
  source      String   @default("Project Gutenberg")
  addedAt     DateTime @default(now())

  progress    ReadingProgress[]
  bookmarks   Bookmark[]
  highlights  Highlight[]
}

model ReadingProgress {
  id              String   @id @default(uuid())
  userId          String
  bookId          String
  location        String
  percentComplete Float    @default(0)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  location  String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Highlight {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  location  String
  text      String
  note      String?
  color     String   @default("#FEF08A") // yellow, green, pink, blue
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}
